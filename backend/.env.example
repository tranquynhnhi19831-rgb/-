# Binance USD-M Demo private execution credentials.
# Never commit real values. Demo and Mainnet credentials are separate.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# Actual virtual-money order routes stay disabled by default. `/order-test`
# remains available because Binance's test endpoint does not create an order.
ENABLE_BINANCE_TESTNET_ORDERS=false

# Optional runtime network path for CCXT. On Windows local development the
# launcher can detect the current user proxy and populate these automatically.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost

# Legacy/admin configuration fields retained for compatibility; S7 private
# Demo order routes do not read these values.
BINANCE_API_KEY=
BINANCE_SECRET=
DEEPSEEK_API_KEY=
